# Hostname only, without https://. Point its DNS A record to the Lightsail IP.
# For a temporary test address, PUBLIC_IP.sslip.io resolves automatically.
SITE_DOMAIN=example.com
AUTH_ALLOWED_EMAILS=you@example.com

# Use hex-only values (openssl rand -hex 24) so they are safe in connection URLs.
MONGO_PASSWORD=replace-with-random-hex
REDIS_PASSWORD=replace-with-random-hex
INTERNAL_API_KEY=replace-with-random-hex
MCP_SECRET=replace-with-random-hex

# Firebase Spark project with Google sign-in enabled.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Groq free-tier key. Google API key enables document, vision and embeddings.
GROQ_API_KEY=
GOOGLE_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Private S3 bucket and an IAM access key restricted to that bucket.
AWS_REGION=ap-south-1
AWS_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
