# Hostname only, without https://. Point its DNS A record to the Lightsail IP.
# For a temporary test address, PUBLIC_IP.sslip.io resolves automatically.
SITE_DOMAIN=example.com
# Set to the browser-facing frontend, either this host or a Vercel domain.
FRONTEND_URL=https://example.com
# Leave blank to allow any verified Google account. Set a comma-separated list for a private deployment.
AUTH_ALLOWED_EMAILS=
# Trial credits given once to each new account. These are app credits, not AWS credits.
PUBLIC_SIGNUP_CREDITS=25

# Use hex-only values (openssl rand -hex 24) so they are safe in connection URLs.
MONGO_PASSWORD=replace-with-random-hex
REDIS_PASSWORD=replace-with-random-hex
INTERNAL_API_KEY=replace-with-random-hex
MCP_SECRET=replace-with-random-hex

# Firebase Spark project with Google sign-in enabled.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# Public ComfyUI tunnel URL (for example an ngrok URL). Keep the tunnel running.
COMFY_API_URL=
POLLINATIONS_API_KEY=

# Google API key serves all model routes. A working Groq key is optional.
GROQ_API_KEY=
GOOGLE_API_KEY=
# These Gemini models use the same Google project as GOOGLE_API_KEY.
GOOGLE_PDF_MODEL=gemini-3.1-flash-lite
GOOGLE_PDF_FALLBACK_MODEL=gemini-2.5-flash
GROQ_MODEL=openai/gpt-oss-120b
