# Copy to .env beside docker-compose.yml.
#
# A sovereign install needs exactly one secret: the key the two services use to
# prove a request came through the gateway. Everything else has a default.

INTERNAL_API_KEY=change-me-to-a-long-random-string
LOCAL_AUTH_USERNAME=admin
# Generate with: LOCAL_AUTH_NEW_PASSWORD='a-strong-password-here' node ../../backend/app/scripts/hash-local-password.mjs
LOCAL_AUTH_PASSWORD_HASH=replace-with-scrypt-hash

WEB_PORT=8080
WEB_BIND=127.0.0.1
# Keep false for localhost HTTP only. Use true behind HTTPS in production.
COOKIE_SECURE=false
FRONTEND_URL=http://127.0.0.1:8080
SOVEREIGN_PUBLIC_URL=http://127.0.0.1:8080

# Preload these models before starting the offline Compose network.
SOVEREIGN_MODEL=qwen2.5:1.5b
# Coding shares SOVEREIGN_MODEL unless a separate local model is configured.
SOVEREIGN_CODING_MODEL=
# Set a local vision model to opt in to image attachments.
SOVEREIGN_VISION_MODEL=
SOVEREIGN_EMBEDDING_MODEL=nomic-embed-text

# Pin these to reviewed image digests for production.
OLLAMA_IMAGE=ollama/ollama:latest
QDRANT_IMAGE=qdrant/qdrant:latest
MONGO_IMAGE=mongo:7
REDIS_IMAGE=redis:7-alpine
