# Copy to .env beside docker-compose.yml.
#
# A sovereign install needs exactly one secret: the key the two services use to
# prove a request came through the gateway. Everything else has a default.

INTERNAL_API_KEY=change-me-to-a-long-random-string

WEB_PORT=8080
FRONTEND_URL=http://localhost:8080
SOVEREIGN_PUBLIC_URL=http://localhost:8080

# Models to pull into Ollama before first use:
#   docker compose exec ollama ollama pull llama3.1
#   docker compose exec ollama ollama pull qwen2.5-coder
#   docker compose exec ollama ollama pull nomic-embed-text
SOVEREIGN_MODEL=llama3.1
SOVEREIGN_CODING_MODEL=qwen2.5-coder
SOVEREIGN_VISION_MODEL=llama3.2-vision
SOVEREIGN_EMBEDDING_MODEL=nomic-embed-text

# ── Cloud Mode only ─────────────────────────────────────────────────────────
# Leave these unset for an air-gapped install. Cloud Mode then fails outright
# rather than half-working, which is the honest behaviour: a mode that silently
# degrades teaches users to distrust the boundary.
GOOGLE_API_KEY=
GROQ_API_KEY=
