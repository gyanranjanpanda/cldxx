# Frontend. Build context is frontend/.
FROM node:22-slim AS build

WORKDIR /src
COPY package*.json ./
RUN npm ci

COPY . .
RUN npm run build

# ── Serve ───────────────────────────────────────────────────────────────────
FROM nginx:alpine

COPY --from=build /src/dist /usr/share/nginx/html

# nginx.conf is mounted by compose rather than copied: it lives outside this
# build context (frontend/), and a COPY across contexts does not build.

EXPOSE 80
