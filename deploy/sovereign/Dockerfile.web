# Frontend. Build context is frontend/.
FROM node:22-slim AS build

WORKDIR /src
ARG VITE_LOCAL_AUTH_ENABLED=true
ARG VITE_SOVEREIGN_ONLY=true
ARG VITE_SOVEREIGN_AVAILABLE=true
ARG VITE_BILLING_ENABLED=false
ARG VITE_SOVEREIGN_VISION_MODEL=
ENV VITE_LOCAL_AUTH_ENABLED=$VITE_LOCAL_AUTH_ENABLED \
    VITE_SOVEREIGN_ONLY=$VITE_SOVEREIGN_ONLY \
    VITE_SOVEREIGN_AVAILABLE=$VITE_SOVEREIGN_AVAILABLE \
    VITE_BILLING_ENABLED=$VITE_BILLING_ENABLED \
    VITE_SOVEREIGN_VISION_MODEL=$VITE_SOVEREIGN_VISION_MODEL
COPY package*.json ./
RUN npm ci

COPY . .
RUN npm run build

# ── Serve ───────────────────────────────────────────────────────────────────
FROM nginx:alpine

COPY --from=build /src/dist /usr/share/nginx/html

# nginx.conf is mounted by compose rather than copied: it lives outside this
# build context (frontend/), and a COPY across contexts does not build.

EXPOSE 80
