# ── Sovereign Mode ───────────────────────────────────────────────────────────
#
# One OpenAI-compatible base URL serves chat, code, vision and embeddings, so
# the runtime is interchangeable: vLLM, SGLang, Ollama and llama.cpp all expose
# this shape. Leave SOVEREIGN_BASE_URL unset and Sovereign Mode refuses every
# turn rather than answering from the cloud.

SOVEREIGN_BASE_URL="http://127.0.0.1:11434/v1"   # Ollama; vLLM is :8000/v1
SOVEREIGN_API_KEY="not-needed"                   # local runtimes ignore this

# Per-agent models. All optional -- each falls back to SOVEREIGN_MODEL, so a
# small install can point every agent at one model.
SOVEREIGN_MODEL="llama3.1"
SOVEREIGN_CODING_MODEL="qwen2.5-coder"
SOVEREIGN_VISION_MODEL="llama3.2-vision"
SOVEREIGN_DOC_MODEL="llama3.1"
SOVEREIGN_EMBEDDING_MODEL="nomic-embed-text"

# Retrieval. Sovereign vectors get their own Qdrant and their own collection
# prefix; the cloud QDRANT_URL is never reused. Unset means the in-process
# memory store, which is local and therefore safe.
SOVEREIGN_QDRANT_URL="http://127.0.0.1:6333"
SOVEREIGN_QDRANT_API_KEY=""

# Generated PDFs and decks are written here instead of S3, and served from the
# agent service at /artifacts.
SOVEREIGN_ARTIFACT_DIR="./artifacts"
SOVEREIGN_PUBLIC_URL="http://127.0.0.1:8003"

# Hash-chained record of every routing decision.
AUDIT_LOG_PATH="./audit/decisions.log"
