# Copy to .env beside index.js. Values are examples, not secrets -- fill in
# your own. Sovereign Mode has its own file: see .env.sovereign.example.

PORT=8003
MONGODB_URL=mongodb://127.0.0.1:27017/cldx

# ── Model providers ─────────────────────────────────────────────────────────
# A user who pastes their own key in the app pays their provider directly and
# that key is preferred; these are the platform's fallback.
GROQ_API_KEY=
DEEPSEEK_API_KEY=
GOOGLE_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
CODING_MAX_TOKENS=8000

TAVILY_API_KEY=

# Raises GitHub's rate limit from 60/hr to 5000/hr and allows private repos.
# Public repositories work without it.
GITHUB_TOKEN=

# ── Storage ─────────────────────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
AWS_BUCKET_NAME=

QDRANT_URL=
QDRANT_API_KEY=

# ── Gateway ─────────────────────────────────────────────────────────────────
# The agent reaches auth and chat over HTTP with a shared key, because those
# routes take a userId in the body rather than a session.
GATEWAY_URL=http://127.0.0.1:8000
INTERNAL_API_URL=http://127.0.0.1:8000/internal
INTERNAL_API_KEY=change-me-to-a-long-random-string

# ── Image generation: self-hosted ComfyUI (Z-Image Turbo) ───────────────────
#
# Base URL of your own ComfyUI. The Image agent posts the workflow here,
# polls /history for the result and fetches the PNG itself, so this value
# never reaches the browser -- generated images are served from S3 instead.
# Leave it unset and the Image pill answers "Image server is offline" rather
# than failing in some less obvious way.
#
# A Colab notebook behind a Cloudflare tunnel hands out a NEW hostname every
# time it restarts, so expect to update this often. It is read per request, so
# a change here only needs a restart of this service, never a code change.
#
#   Health check:  curl $COMFY_URL/system_stats
COMFY_URL=https://your-tunnel.trycloudflare.com

# The exported workflow the Image agent clones per request. Defaults to
# workflow_api.json in the repo root; set this only if the file lives
# elsewhere, such as inside a container image.
#
# It must be ComfyUI's API format -- the "Export (API)" menu item, not "Save".
# The positive CLIPTextEncode node and the sampler's seed are found by walking
# the graph, so re-exporting with different node ids is safe.
# COMFY_WORKFLOW=/app/workflow_api.json
