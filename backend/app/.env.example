# Slack MCP OAuth
# Register this exact callback URL in the Slack app settings.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=https://your-public-host.example.com/api/mcp/oauth/slack/callback
SLACK_OAUTH_SCOPES=search:read.public,search:read.private,search:read.mpim,search:read.im,search:read.files,files:read,users:read,channels:history,groups:history,im:history,mpim:history,chat:write

# Add another OAuth provider by adding its preset in backend/app/modules/mcp/providers.js
# and matching PROVIDER_CLIENT_ID, PROVIDER_CLIENT_SECRET, and PROVIDER_REDIRECT_URI.
# Or declare a standard OAuth provider without code changes:
# MCP_OAUTH_PROVIDERS=[{"id":"linear","name":"Linear","description":"Linear MCP","mcpUrl":"https://example.com/mcp","authorizeUrl":"https://example.com/oauth/authorize","tokenUrl":"https://example.com/oauth/token","scopes":["read"],"tokenField":"access_token"}]

# Maximum uploaded image/document size for the agent.
# The frontend is aligned with the default 20 MB value.
MAX_UPLOAD_MB=20
